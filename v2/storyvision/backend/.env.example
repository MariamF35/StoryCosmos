# StoryVision v2 Configuration

PORT=8787

# Optional: Anthropic Claude API Key for narrative scene decomposition into 3 visual angles
ANTHROPIC_API_KEY=

# Optional: OpenAI API Key (if you want to use DALL-E 3 for image generation)
OPENAI_API_KEY=

# Optional: Google Gemini API Key (if you want to use Imagen for image generation)
GEMINI_API_KEY=

# Note: If no image API keys are provided, StoryVision v2 automatically uses 
# Pollinations AI (Flux model) out of the box with zero setup required!
